# =========================
# LIMATA Development Environment
# =========================

# =========================
# Frontend (apps/web)
# =========================
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_AI_API_URL=http://localhost:8000

# =========================
# Backend API (apps/api)
# =========================
API_PORT=4000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/limata"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/limata"
JWT_SECRET="your-development-jwt-secret-do-not-use-in-production"

# =========================
# AI Service (apps/ai-service)
# =========================
AI_SERVICE_PORT=8000
MODEL_PATH="./weights"

# =========================
# Cloudflare R2 (Optional for local dev)
# =========================
R2_ACCOUNT_ID="your_account_id"
R2_ACCESS_KEY="your_access_key"
R2_SECRET_KEY="your_secret_key"
R2_BUCKET="limata-dev"
R2_ENDPOINT="https://your_account_id.r2.cloudflarestorage.com"
